# Copy to ~/mamoni/.env on the server and fill in. Never commit the real file.
APP_NAME="Mamoni Bosraloy"
APP_ENV=staging
APP_KEY=
APP_DEBUG=false
APP_URL=https://mamoni.shafiqul.dev
APP_LOCALE=en
STORE_DEFAULT_LOCALE=bn
APP_FALLBACK_LOCALE=en
LOG_CHANNEL=stack
LOG_LEVEL=warning
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=fashion
DB_USERNAME=fashion
DB_PASSWORD=CHANGE_ME_LONG_RANDOM
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
CACHE_STORE=redis
QUEUE_CONNECTION=redis
REDIS_CLIENT=predis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379
MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_FROM_ADDRESS="store@mamoni.shafiqul.dev"
MAIL_FROM_NAME="Mamoni Bosraloy"
MEDIA_DISK=public
VITE_APP_NAME="Mamoni Bosraloy"
# Where the web container listens on the host. Keep 127.0.0.1 if cloudflared runs on the host.
# If cloudflared runs inside Docker, set WEB_BIND to the docker0 gateway (usually 172.17.0.1).
WEB_BIND=127.0.0.1
WEB_PORT=8090
